# Microsoft Foundry Configuration (for MAF - preferred)
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Azure OpenAI Configuration (Service Principal required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AD Service Principal (required)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure AI Search Configuration (for document grounding)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=kyc-documents

# Application Settings
APP_ENV=development
LOG_LEVEL=DEBUG
ENABLE_DOCUMENT_GROUNDING=false

# Application Insights (for agent tracing and monitoring)
# Get this from Azure Portal > Application Insights > Overview > Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=
